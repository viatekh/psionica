---
layout: base.njk
pagination:
  data: inventory.categories
  size: 1
  alias: shelf
permalink: "/shelf/{{ shelf.slug }}/"
eleventyComputed:
  title: "{{ shelf.name }}"
---
{% from "card.njk" import entries %}
<section class="sec">
  <h1>{{ shelf.name | upper }}</h1>
  <p class="count">{{ shelf.items.length }} titles.</p>
  {{ entries(shelf.entries) }}
</section>
<p><a href="{{ '/' | url }}">&larr; Whole catalogue</a></p>
