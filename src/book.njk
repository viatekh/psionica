---
layout: base.njk
pagination:
  data: inventory.books
  size: 1
  alias: book
permalink: "/book/{{ book.id }}/"
eleventyComputed:
  title: "{{ book.title }}"
  description: "{{ book.title }}{% if book.author %} by {{ book.author }}{% endif %}, at Psionica."
---
<article class="rec">
  <div class="bigcov">{% if book.image %}<img src="{{ book.image }}" alt="Cover of {{ book.title }}">{% else %}<span class="label"><span>{{ book.title }}</span>{% if book.author %}<span class="la">{{ book.author }}</span>{% endif %}</span>{% endif %}</div>
  <div class="body">
  <p class="no">No. {{ book.no }} · <a href="{{ ('/shelf/' + book.categorySlug + '/') | url }}">{{ book.category | upper }}</a></p>
  {% if book.author %}<p class="au">{{ book.author | upper }}.</p>{% endif %}
  <h1>{{ book.title }}.</h1>
  {% if book.blurb %}<p>{{ book.blurb }}</p>{% endif %}
  {% if book.year or book.format or book.condition or book.isbn or book.sku %}<dl class="fields">
    {% if book.year %}<dt>Year</dt><dd>{{ book.year }}</dd>{% endif %}
    {% if book.format %}<dt>Format</dt><dd>{{ book.format | capitalize }}</dd>{% endif %}
    {% if book.condition %}<dt>Condition</dt><dd>{{ book.condition }}</dd>{% endif %}
    {% if book.isbn %}<dt>ISBN</dt><dd>{{ book.isbn }}</dd>{% endif %}
    {% if book.sku %}<dt>Ref</dt><dd>{{ book.sku }}</dd>{% endif %}
  </dl>{% endif %}
  {% if book.status == 'stock' %}
    <p class="ok big">In stock</p>
    <p>Online buying opens soon. To reserve a copy now, write to <span class="sel">{{ site.email }}</span>.</p>
  {% elif book.status == 'sold' %}
    <p class="ns">Sold.</p>
  {% else %}
    <p class="pr big">{{ book.price | gbp }}</p>
    {% if book.buy %}<p><a class="buy" href="{{ book.buy }}">[ BUY THIS COPY ]</a></p>
    <p class="small">Card, Apple Pay or Google Pay through Stripe. UK postage added at checkout. One copy only.</p>
    {% else %}<p class="small">Not yet for sale online. Ask at the stall.</p>{% endif %}
  {% endif %}
  </div>
</article>
<p><a href="{{ ('/shelf/' + book.categorySlug + '/') | url }}">&larr; {{ book.category }}</a></p>
