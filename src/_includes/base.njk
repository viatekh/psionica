<!doctype html>
<html lang="en-GB">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if title %}{{ title }} · {% endif %}{{ site.name }}</title>
<meta name="description" content="{{ description or site.tagline }}">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:title" content="{{ title or site.name }}">
<meta property="og:description" content="{{ description or site.tagline }}">
<meta property="og:type" content="{% if book %}product{% else %}website{% endif %}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
{% if book and book.image %}<meta property="og:image" content="{% if book.image.startsWith('/') %}{{ site.url }}{% endif %}{{ book.image }}">{% endif %}
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<link rel="icon" href="{{ '/assets/favicon.svg' | url }}" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Nanum+Gothic:wght@400;700;800&display=swap">
<link rel="stylesheet" href="{{ '/assets/style.css' | url }}?v={{ build }}">
</head>
<body>
<div class="sheet">
<header class="hero">
  <div class="crown">
    <a class="side" href="{{ '/about/' | url }}">{% heading "About" %}</a>
    <a href="{{ '/' | url }}" aria-label="{{ site.name }}, home">{% set cls = "mark" %}{% include "mark.njk" %}</a>
    <a class="side" href="{{ '/about/' | url }}#where">{% heading "Events" %}</a>
  </div>
  <a href="{{ '/' | url }}" class="name" aria-label="{{ site.name }}, home">{% include "wordmark.njk" %}</a>
  {% include "zener.njk" %}
</header>
<div class="thread" aria-hidden="true"></div>
<nav class="menu" aria-label="Shelves">
  <a href="{{ '/' | url }}"{% if page.url == '/' %} class="on"{% endif %}>Everything</a>
  {% for c in inventory.categories %}<a href="{{ ('/shelf/' + c.slug + '/') | url }}"{% if page.url == '/shelf/' + c.slug + '/' %} class="on"{% endif %}>{{ c.name | replace(" and ", " & ") }}</a>{% endfor %}
  {% if inventory.hunting.length %}<a class="hunt{% if page.url == '/hunting/' %} on{% endif %}" href="{{ '/hunting/' | url }}">Hunting</a>{% endif %}
</nav>
<div class="thread" aria-hidden="true"></div>
<main>
{{ content | safe }}
</main>
<div class="thread foot-thread" aria-hidden="true"></div>
<footer class="foot">
  <div>{% set cls = "fm" %}{% include "mark.njk" %}<p>{{ site.name }}. {{ site.tagline }}.</p></div>
  <div><h3>Next stall</h3><p>None booked yet. Dates will appear on the <a href="{{ '/about/' | url }}#where">events page</a>.</p></div>
  <div><h3>Postage</h3><p>Royal Mail within two working days, in board-backed mailers. UK only for now.</p></div>
  <div><h3>Write to us</h3><p><span class="sel">{{ site.email }}</span><br>Curated with love by Sybil and Tekh.</p></div>
</footer>
</div>
</body>
</html>
