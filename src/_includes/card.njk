{% macro entries(list) %}
<ol class="grid">
  {% for b in list %}<li class="{{ b.status }}"><a href="{{ ('/book/' + b.id + '/') | url }}">
    <span class="cov">{% if b.image %}<img src="{{ b.image }}" alt="" loading="lazy">{% else %}<span class="label"><span>{{ b.title }}</span>{% if b.author %}<span class="la">{{ b.author }}</span>{% endif %}</span>{% endif %}</span>
    <span class="txt">{% if b.author %}<span class="au">{{ b.author | upper }}</span>{% endif %}<span class="ti">{{ b.title }}</span>
    {% if b.status == 'listed' %}<span class="pr">{{ b.price | gbp }}</span>{% elif b.status == 'sold' %}<span class="ns">Sold</span>{% elif b.status == 'out' %}<span class="ns">Out of stock</span>{% elif b.price %}<span class="pr">{{ b.price | gbp }}</span>{% else %}<span class="ok">In stock</span>{% endif %}</span>
  </a></li>{% endfor %}
</ol>
{% endmacro %}
