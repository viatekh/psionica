{% macro entries(list) %}
<ol class="list">
  {% for b in list %}<li value="{{ b.no }}" class="{{ b.status }}">{% if b.author %}<span class="au">{{ b.author | upper }}.</span> {% endif %}<a href="{{ ('/book/' + b.id + '/') | url }}">{{ b.title }}</a>.
  {% if b.status == 'listed' %}{% if b.format %}{{ b.format | capitalize }}.{% endif %} {% if b.condition %}{{ b.condition }}.{% endif %} <span class="pr">{{ b.price | gbp }}</span>{% elif b.status == 'sold' %}<span class="ns">Sold.</span>{% else %}<span class="ns">Wanted. Not in stock.</span>{% endif %}</li>
  {% endfor %}
</ol>
{% endmacro %}
