{% macro card(b) %}
<a class="card{% if b.status == 'sold' %} sold{% endif %}" href="{{ ('/book/' + b.id + '/') | url }}">
  <div class="cover">{% if b.image %}<img src="{{ b.image }}" alt="" loading="lazy">{% else %}<span class="nocover">{{ b.title }}</span>{% endif %}</div>
  <div class="meta">
    <span class="t">{{ b.title }}</span>
    {% if b.author %}<span class="a">{{ b.author }}</span>{% endif %}
    <span class="p">{% if b.status == 'sold' %}Sold{% else %}{{ b.price | gbp }}{% endif %}</span>
  </div>
</a>
{% endmacro %}

{% macro entries(list) %}
<ul class="entries">
  {% for b in list %}<li><a href="{{ ('/book/' + b.id + '/') | url }}"><span class="t">{{ b.title }}</span>{% if b.author %}<span class="a">{{ b.author }}</span>{% endif %}<span class="s">Not in stock</span></a></li>{% endfor %}
</ul>
{% endmacro %}
