{% macro card(b) %}
<a class="card{% if b.status == 'sold' %} sold{% endif %}" href="{{ ('/book/' + (b.sku | lower) + '/') | url }}">
  <div class="cover">{% if b.image %}<img src="{{ b.image }}" alt="" loading="lazy">{% else %}<span class="nocover">{{ b.title }}</span>{% endif %}</div>
  <div class="meta">
    <span class="t">{{ b.title }}</span>
    {% if b.author %}<span class="a">{{ b.author }}</span>{% endif %}
    <span class="p">{% if b.status == 'sold' %}Sold{% else %}{{ b.price | gbp }}{% endif %}</span>
  </div>
</a>
{% endmacro %}
