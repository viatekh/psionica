---
layout: base.njk
---
{% from "card.njk" import shelf, huntbox %}
<div class="filters" role="group" aria-label="Filter books"><span>Show</span>
  <button type="button" data-f="all" aria-pressed="true">Everything</button>
  <button type="button" data-f="cheap" aria-pressed="false">Under £10</button>
  <button type="button" data-f="rare" aria-pressed="false">Rare, £50 and up</button>
</div>

{% for c in inventory.categories %}{% if c.home.length %}
<section class="sec filterable" id="{{ c.slug }}">
  <div class="sec-head"><h2><a href="{{ ('/shelf/' + c.slug + '/') | url }}">{{ c.name }}</a></h2></div>
  {{ shelf(c.home) }}
</section>
{% endif %}{% endfor %}
<p class="empty" id="none" hidden>Nothing matches that filter right now.</p>

{% if inventory.hunting.length %}
<section class="sec" id="hunting">
  {{ huntbox(inventory.hunting, site) }}
</section>
{% endif %}

{% if inventory.vault.length %}
<section class="sec" id="vault">
  <div class="sec-head"><h2>From the vault</h2></div>
  <div class="vault">
    <div class="fan-scroll"><div class="fan">
      {% for b in inventory.vault %}{% if b.image %}<a href="{{ ('/book/' + b.id + '/') | url }}" title="{{ b.title }}" style="--r:{{ (loop.index0 - (inventory.vault.length - 1) / 2) * 2 }}deg"><img src="{{ b.image | asset }}" alt="{{ b.title }}" loading="lazy"></a>{% endif %}{% endfor %}
    </div></div>
    <div class="vault-foot"><span>Write to <span class="sel">{{ site.email }}</span> for prices and photos.</span><span class="stamp sm">POA</span></div>
  </div>
</section>
{% endif %}

<script>
const buttons = [...document.querySelectorAll(".filters button")];
const tests = { all: () => true, cheap: (c) => c.dataset.price > 0 && c.dataset.price < 10, rare: (c) => c.dataset.price >= 50 || "poa" in c.dataset };
buttons.forEach((b) => b.addEventListener("click", () => {
  buttons.forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
  let total = 0;
  document.querySelectorAll(".filterable").forEach((sec) => {
    let shown = 0;
    sec.querySelectorAll(".bk").forEach((c) => { const ok = tests[b.dataset.f](c); c.hidden = !ok; shown += ok; });
    sec.hidden = !shown; total += shown;
  });
  document.getElementById("none").hidden = total > 0;
}));
</script>
