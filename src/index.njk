---
layout: base.njk
---
{% from "card.njk" import entries %}
<div class="intro">
  <p>Got one to sell, or want one we haven't listed? Write to <span class="sel">{{ site.email }}</span>.</p>
</div>

{% for c in inventory.categories %}
<section class="sec" id="{{ c.slug }}">
  <h2><a href="{{ ('/shelf/' + c.slug + '/') | url }}">{{ c.name | upper }}</a> <span>{{ c.items.length }} titles</span></h2>
  {{ entries(c.entries) }}
</section>
{% endfor %}
